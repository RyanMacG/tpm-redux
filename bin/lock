#!/usr/bin/env bash

# Lock file generator for TPM Redux
# Records the exact commit hash for each installed plugin

CURRENT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
LIB_DIR="$CURRENT_DIR/../lib"

source "$LIB_DIR/core.sh"
source "$LIB_DIR/git.sh"

generate_lock_file() {
    local config_path="${1:-$(get_tmux_config_path)}"
    local lock_file
    lock_file="$(get_lock_file_path)"
    local plugins
    plugins="$(parse_plugins "$config_path")"

    local lock_count=0
    local skip_count=0
    local lines=()

    while IFS= read -r plugin_spec; do
        [[ -z "$plugin_spec" ]] && continue
        local plugin_path
        plugin_path="$(get_plugin_path "$plugin_spec")"
        if [[ ! -d "$plugin_path" ]] || ! is_git_repo "$plugin_path"; then
            skip_count=$(( skip_count + 1 ))
            continue
        fi
        local hash
        hash="$(cd "$plugin_path" && git rev-parse HEAD 2>/dev/null)"
        if [[ -n "$hash" ]]; then
            lines+=("$plugin_spec $hash")
            lock_count=$(( lock_count + 1 ))
        fi
    done <<< "$plugins"

    {
        echo "# tpm.lock - generated by tpm-redux"
        echo "# Do not edit manually"
        echo ""
        for line in "${lines[@]}"; do
            echo "$line"
        done
    } > "$lock_file"

    echo "Lock file written: $lock_file ($lock_count plugins locked, $skip_count skipped)"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    generate_lock_file "$@"
fi
